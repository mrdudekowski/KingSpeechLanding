# Ignore everything by default
*

# Allow only production site files in repo root
!/.nojekyll
!/index.html
!/assets/

# Allow specific asset subtrees
!/assets/css/**
!/assets/js/**
!/assets/images/**
!/assets/videos/**
!/assets/data/translations/**
!/assets/fonts/**

# Always ignore
*.MOV
*.md
/node_modules/
/demos/
/docs/
/scripts/
/backup_*/
/nervouslola-website/
/landing_memory_bank/
#! nervousdata: include all except demos
!/nervousdata/**
/nervousdata/demos/
/@LANGUAGEBUTTON/

