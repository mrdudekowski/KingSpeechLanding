/* ========================================
   ICON FIXES - Исправления для иконок меню
   ======================================== */

/* Основные стили для иконок меню */
.menu-category h3 .menu-icon {
    /* Принудительное отображение */
    display: inline-block !important;
    width: 24px !important;
    height: 24px !important;
    max-width: none !important;
    margin: 0 8px !important;
    
    /* Стилизация */
    filter: brightness(0) invert(1) !important;
    opacity: 1 !important;
    visibility: visible !important;
    vertical-align: middle !important;
    
    /* Позиционирование */
    position: static !important;
    z-index: auto !important;
    
    /* Переопределение reset.css */
    box-sizing: content-box !important;
    border: none !important;
    outline: none !important;
    background: none !important;
    background-image: none !important;
    content: none !important;
    font-size: 0 !important;
    line-height: 0 !important;
    
    /* Оптимизация изображения */
    object-fit: contain !important;
    object-position: center !important;
    
    /* Плавные переходы */
    transition: all 0.3s ease !important;
}

/* Эффекты при наведении */
.menu-category:hover .menu-icon {
    transform: scale(1.1) !important;
    filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(212, 175, 55, 0.6)) !important;
}

/* Адаптивность */
@media (max-width: 768px) {
    .menu-category h3 .menu-icon {
        width: 20px !important;
        height: 20px !important;
        margin: 0 6px !important;
    }
}

@media (max-width: 480px) {
    .menu-category h3 .menu-icon {
        width: 18px !important;
        height: 18px !important;
        margin: 0 4px !important;
    }
}

/* Fallback для случаев, когда изображения не загружаются */
.menu-category h3 .menu-icon:not([src]),
.menu-category h3 .menu-icon[src=""],
.menu-category h3 .menu-icon[src*="undefined"] {
    background: var(--color-accent) !important;
    border-radius: 50% !important;
    position: relative !important;
}

.menu-category h3 .menu-icon:not([src])::after,
.menu-category h3 .menu-icon[src=""]::after,
.menu-category h3 .menu-icon[src*="undefined"]::after {
    content: '☕' !important;
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    color: white !important;
    font-size: 12px !important;
    line-height: 1 !important;
}

/* Специфичные стили для разных типов иконок */
.menu-category h3 .coffee-icon:not([src])::after,
.menu-category h3 .coffee-icon[src=""]::after,
.menu-category h3 .coffee-icon[src*="undefined"]::after {
    content: '☕' !important;
}

.menu-category h3 .teapot-icon:not([src])::after,
.menu-category h3 .teapot-icon[src=""]::after,
.menu-category h3 .teapot-icon[src*="undefined"]::after {
    content: '🫖' !important;
}

.menu-category h3 .hotchoc-icon:not([src])::after,
.menu-category h3 .hotchoc-icon[src=""]::after,
.menu-category h3 .hotchoc-icon[src*="undefined"]::after {
    content: '🍫' !important;
}

.menu-category h3 .rum-icon:not([src])::after,
.menu-category h3 .rum-icon[src=""]::after,
.menu-category h3 .rum-icon[src*="undefined"]::after {
    content: '🥃' !important;
}

